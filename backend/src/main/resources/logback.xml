<configuration>
    <conversionRule conversionWord="elapsed"
                    class="com.companyb.companyapp.logging.RequestElapsedConverter" />
    <conversionRule conversionWord="delta"
                    class="com.companyb.companyapp.logging.DeltaTimeConverter" />

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>true</withJansi>
        <encoder>
            <pattern>%-30(%d{STRICT, Asia/Manila} [%thread]) %highlight(%5level) [TraceId-%X{traceId}] +%delta ms. %green(%logger{36}) - %cyan(%msg%n) %red(%rEx{full})</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
