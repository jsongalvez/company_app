#!/bin/bash
set -euo pipefail

# Near-zero-cost pre-commit hook (map #329).
#
# This hook performs bookkeeping only: staged-Kotlin formatting with the
# standalone ktlint CLI and syntax checks for staged shell files. It must
# never start Gradle, Postgres, the backend, k6, JMH, OpenAPI generation,
# Compose compilation, broad tests, or any network-dependent validation.
# Compile/static/test coverage is the agent's targeted, warm, on-demand
# local validation plus asynchronous CI — never a commit toll.

HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$HOOKS_DIR/.." && pwd)"
source "$ROOT_DIR/scripts/lib/common.sh"
LOG_TAG=pre-commit
log pre-commit "$@"

# Classify staged changes before any formatter work so documentation-only
# commits skip even the cheap checks.
STAGED_FILES="$(git diff --cached --no-renames --name-only)"
PRE_COMMIT_CLASSIFICATION="$(printf '%s\n' "$STAGED_FILES" | bash "$ROOT_DIR/scripts/classify-push-files.sh")"
log pre-commit "Staged change classification: $PRE_COMMIT_CLASSIFICATION"
if [ "$PRE_COMMIT_CLASSIFICATION" = "docs-only" ]; then
    log pre-commit "Documentation-only staged change; skipping local checks."
    exit 0
fi

# ----------------------------------------------------------------
# 1. Format staged Kotlin files (standalone ktlint CLI only)
# ----------------------------------------------------------------
# The ktlint Gradle plugin doesn't support file-scoped formatting, and Gradle
# is banned from hooks (map #329), so only the standalone CLI qualifies.
KT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(kt|kts)$' || true)

if [ -z "$KT_FILES" ]; then
    log pre-commit "No staged Kotlin files — skipping ktlint"
else
    # Resolve ktlint command: PATH, then ~/.cache/company-app/ktlint (installed by setup-hooks.sh)
    KTLINT_CMD=""
    if command -v ktlint &>/dev/null; then
        KTLINT_CMD="ktlint"
    elif [ -x "$HOME/.cache/company-app/ktlint/1.8.0" ]; then
        KTLINT_CMD="$HOME/.cache/company-app/ktlint/1.8.0"
    fi

    if [ -n "$KTLINT_CMD" ]; then
        log pre-commit "Formatting staged Kotlin file(s) with $KTLINT_CMD..."
        echo "$KT_FILES" | tr '\n' '\0' | xargs -0 -r "$KTLINT_CMD" --format 2>&1 | tail -3
        log pre-commit "Re-staging formatted files..."
        echo "$KT_FILES" | tr '\n' '\0' | xargs -0 -r git add
        log pre-commit "Formatting complete."
    else
        # Never fall back to project-wide Gradle formatting: a missing formatter
        # must not turn a commit into a multi-minute build. Formatting debt is
        # caught by asynchronous ktlintCheck in CI.
        log pre-commit "WARNING: ktlint not found — skipping staged Kotlin formatting."
        log pre-commit "Run 'bash scripts/setup-hooks.sh' to install ktlint."
    fi
fi

# ----------------------------------------------------------------
# 2. Syntax-check staged shell files
# ----------------------------------------------------------------
SHELL_FILES=()
while IFS= read -r file; do
    case "$file" in
        *.sh|scripts/**/*.sh|.githooks/*)
            # Staged deletions appear in the name list but no longer exist on disk.
            [[ -f "$file" ]] && SHELL_FILES+=("$file") ;;
    esac
done <<< "$STAGED_FILES"

if [ "${#SHELL_FILES[@]}" -gt 0 ]; then
    log pre-commit "Checking staged shell syntax..."
    bash -n "${SHELL_FILES[@]}"
fi

log pre-commit "Pre-commit checks passed; compile/test/static analysis run on demand and asynchronously, not at commit time."
