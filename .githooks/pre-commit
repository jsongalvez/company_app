#!/bin/bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

log() { echo "$(date '+%H:%M:%S') [pre-commit] $*"; }

# ----------------------------------------------------------------
# 1. Optimize imports (auto-fix via ktlintFormat)
# ----------------------------------------------------------------
log "Running ktlintFormat to optimize imports and fix formatting..."
./gradlew ktlintFormat --no-daemon 2>&1 | tail -3
log "Re-staging auto-fixed files..."
git add -u
log "Import optimization complete."

# ----------------------------------------------------------------
# 2. Quality gate
# ----------------------------------------------------------------
log "Running quality gate (detekt, ktlint, test, jmhClasses)..."
./gradlew :backend:detekt :backend:ktlintCheck :backend:test :backend:jmhClasses --no-daemon 2>&1 | tail -5
log "Quality gate passed."

# ----------------------------------------------------------------
# 2b. Test-data cleanliness check
# ----------------------------------------------------------------
log "Checking for test-data leaks..."
if ! bash scripts/check-test-cleanliness.sh 2>&1 | tail -5; then
    log "ERROR: Test-data leak detected. All test tables must be empty after the test suite."
    exit 1
fi
log "Test-data cleanliness check passed."

# ----------------------------------------------------------------
# 2c. ComposeApp compilation check (all targets)
# ----------------------------------------------------------------
log "Compiling composeApp (desktop + android)..."
./gradlew :composeApp:compileKotlinDesktop :composeApp:compileDebugKotlinAndroid --no-daemon 2>&1 | tail -5
log "composeApp compilation passed."

# ----------------------------------------------------------------
# 3. Ensure Postgres is reachable
# ----------------------------------------------------------------
source .env 2>/dev/null || true
DB_HOST="${DB_HOST:-localhost}"
DB_PORT="${DB_PORT:-5432}"
POSTGRES_USER="${POSTGRES_USER:-company_user}"
POSTGRES_DB="${POSTGRES_DB:-company_app}"

log "Checking Postgres connectivity at $DB_HOST:$DB_PORT..."
if command -v pg_isready &>/dev/null; then
    if ! pg_isready -h "$DB_HOST" -p "$DB_PORT" -U "$POSTGRES_USER" -d "$POSTGRES_DB" &>/dev/null; then
        log "ERROR: Postgres is not reachable at $DB_HOST:$DB_PORT."
        log "Start it with: docker compose -f docker/docker-compose.yml up -d"
        exit 1
    fi
elif command -v psql &>/dev/null; then
    if ! PGPASSWORD="${POSTGRES_PASSWORD:-}" psql -h "$DB_HOST" -p "$DB_PORT" -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "SELECT 1" &>/dev/null; then
        log "ERROR: Postgres is not reachable at $DB_HOST:$DB_PORT."
        log "Start it with: docker compose -f docker/docker-compose.yml up -d"
        exit 1
    fi
else
    # Fallback: try connecting via /dev/tcp (bash builtin)
    if ! timeout 3 bash -c "echo > /dev/tcp/$DB_HOST/$DB_PORT" 2>/dev/null; then
        log "ERROR: Postgres is not reachable at $DB_HOST:$DB_PORT."
        log "Start it with: docker compose -f docker/docker-compose.yml up -d"
        exit 1
    fi
fi
log "Postgres is reachable."

# ----------------------------------------------------------------
# 4. Build and boot the app, verify it starts
# ----------------------------------------------------------------
log "Building backend distribution..."
./gradlew :backend:installDist --no-daemon 2>&1 | tail -3
log "Build complete."

log "Starting app to verify boot..."
APP_PORT="${APP_PORT:-3023}"

# Run the app in background
./gradlew :backend:run --no-daemon > /tmp/company-app-boot.log 2>&1 &
APP_PID=$!

# Wait for the app to bind the port
APP_STARTED=false
for i in $(seq 1 45); do
    if ! kill -0 "$APP_PID" 2>/dev/null; then
        wait "$APP_PID" || true
        log "ERROR: App process died during startup. Last 20 lines of log:"
        tail -20 /tmp/company-app-boot.log
        exit 1
    fi
    # Check if port is listening
    if command -v lsof &>/dev/null; then
        if lsof -i ":$APP_PORT" -P 2>/dev/null | grep -q LISTEN; then
            APP_STARTED=true
            break
        fi
    elif command -v ss &>/dev/null; then
        if ss -tlnp "sport = :$APP_PORT" 2>/dev/null | grep -q LISTEN; then
            APP_STARTED=true
            break
        fi
    fi
    sleep 1
done

if [ "$APP_STARTED" = false ]; then
    log "ERROR: App did not start within 45 seconds. Last 20 lines of log:"
    tail -20 /tmp/company-app-boot.log
    kill "$APP_PID" 2>/dev/null || true
    exit 1
fi

log "App is running and listening on port $APP_PORT."

# ----------------------------------------------------------------
# 4b. Health check — verify app responds and Postgres is reachable
# ----------------------------------------------------------------
HEALTH_RETRIES=10
HEALTH_DELAY=2
APP_HOST="${APP_HOST:-localhost}"
HEALTH_URL="http://$APP_HOST:$APP_PORT/health"
HEALTH_OK=false
HTTP_STATUS=""

log "Checking /health endpoint (up to $HEALTH_RETRIES attempts, ${HEALTH_DELAY}s apart)..."
for i in $(seq 1 $HEALTH_RETRIES); do
    if ! kill -0 "$APP_PID" 2>/dev/null; then
        log "ERROR: App process died during health check."
        tail -20 /tmp/company-app-boot.log
        kill "$APP_PID" 2>/dev/null || true
        exit 1
    fi
    HTTP_STATUS=$(curl -s -o /tmp/company-app-health.json -w "%{http_code}" "$HEALTH_URL" 2>/dev/null || echo "000")
    if [ "$HTTP_STATUS" = "200" ]; then
        HEALTH_OK=true
        break
    fi
    log "  Attempt $i/$HEALTH_RETRIES: HTTP $HTTP_STATUS (retrying in ${HEALTH_DELAY}s)..."
    sleep "$HEALTH_DELAY"
done

if [ "$HEALTH_OK" = false ]; then
    log "ERROR: /health returned HTTP $HTTP_STATUS after $HEALTH_RETRIES attempts."
    log "Last response body:"
    cat /tmp/company-app-health.json 2>/dev/null || true
    kill "$APP_PID" 2>/dev/null || true
    exit 1
fi

log "Health check passed (HTTP 200)."

# ----------------------------------------------------------------
# 5. Cleanup: kill the app
# ----------------------------------------------------------------
log "Stopping app (PID $APP_PID)..."
kill "$APP_PID" 2>/dev/null || true
# Give it a moment to shut down gracefully
for i in $(seq 1 10); do
    if ! kill -0 "$APP_PID" 2>/dev/null; then
        break
    fi
    sleep 1
done
kill -9 "$APP_PID" 2>/dev/null || true
wait "$APP_PID" 2>/dev/null || true
log "App stopped."

log "All checks passed — commit allowed."
