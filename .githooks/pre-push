#!/bin/bash
set -euo pipefail

# Near-zero-cost pre-push hook (map #329).
#
# This hook is bookkeeping only. It must never run Gradle, Detekt, ktlintCheck,
# warning-as-error compiles, database queries, backend startup, OpenAPI builds,
# Compose compilation, k6, JMH, tests, or any network-dependent validation.
# Full validation is asynchronous CI; targeted local validation is the agent's
# on-demand choice while implementing — never a push toll.

HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$HOOKS_DIR/.." && pwd)"
source "$ROOT_DIR/scripts/lib/common.sh"
LOG_TAG=pre-push

log pre-push "$@"
log pre-push "No local gates: full validation runs asynchronously in CI."
