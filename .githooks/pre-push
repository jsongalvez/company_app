#!/bin/bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

log() { echo "$(date '+%H:%M:%S') [pre-push] $*"; }

# ----------------------------------------------------------------
# 1. Test-data cleanliness check
# ----------------------------------------------------------------
log "Checking for test-data leaks..."
if ! bash scripts/check-test-cleanliness.sh 2>&1 | tail -5; then
    log "ERROR: Test-data leak detected before push."
    exit 1
fi
log "Test-data cleanliness check passed."

# ----------------------------------------------------------------
# 2. JMH full benchmark suite
# ----------------------------------------------------------------
log "Running JMH benchmarks..."
if ! ./gradlew :backend:jmh --no-daemon 2>&1 | tee /tmp/company-app-jmh.log | tail -20; then
    log "ERROR: JMH benchmarks failed. Fix before pushing."
    exit 1
fi
log "JMH benchmarks passed."

# ----------------------------------------------------------------
# 2. Baseline comparison
# ----------------------------------------------------------------
log "Comparing JMH results against baseline..."
if ! bash scripts/check-baselines.sh /tmp/company-app-jmh.log 2>&1 | tail -20; then
    log "ERROR: JMH score regression >20% detected."
    exit 1
fi
log "Baseline comparison passed."

log "Pre-push checks passed."
