// Company App — Database ER Diagram

// NOTE: "No record is ever mutated" is misaligned. system is stateful with audit log, not immutable. Update documentation.
// NOTE: "A user has exactly one role". Allow multiple roles to prevent role explosion
// NOTE: Multiple active delegates allowed
// NOTE: "Compensation is always non-zero", allow zero for edge cases (unpaid roles), move "never zero" to application layer in needed

// TODO: stress-testing this schema against edge cases (voids, retro edits, remittance overlaps)
// TODO: add currency, but how? per table? centralized?

// ============================================================
// USERS & BRANCHES
// ============================================================

Enum user_status {
  ACTIVE
  INACTIVE
}

Table app_user {
  id            uuid         [pk, default: `gen_random_uuid()`]
  username      varchar(255) [not null, unique]
  password_hash varchar(60)  [not null]
  status        user_status  [not null, default: 'ACTIVE']
}

Table role {
  id   uuid [pk, default: `gen_random_uuid()`]
  name text [not null, unique, note: '''
    SUPERUSER
    OWNER
    MANAGER
    COORDINATOR
    PRACTITIONER
    ACCOUNTANT
    VIEWER
  ''']

  note: '''
    Convenient abstraction layer for capability. Predefined bundles of capabilities.

    Never check role in logic. Check against capability.
  '''
}

Table capability {
  id   uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique]
}

Table role_capability {
  role_id       uuid [not null, ref: > role.id]
  capability_id uuid [not null, ref: > capability.id]

  indexes {
    (role_id, capability_id) [unique]
  }
}

Table user_role {
  user_id uuid [not null, ref: > app_user.id]
  role_id uuid [not null, ref: > role.id]

  indexes {
    (user_id, role_id) [unique]
  }
}

// GLOBAL, BRANCH are just ideas, no concrete plans yet
Enum capability_context_type {
  GLOBAL
  BRANCH
  BRANCH_DAY
  MEDICAL_MISSION
  PROVINCIAL_TOUR
}

// MANUAL_OVERRIDE, SYSTEM are just ideas, no concrete plans yet
Enum capability_source_type {
  RELIEF_ACCESS
  MEDICAL_MISSION_DELEGATE
  MANUAL_OVERRIDE
  SYSTEM
}

Table user_capability {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > app_user.id]
  capability_id uuid [not null, ref: > capability.id, note: 'e.g. code for EDIT_BRANCH_DATA']
  context_type capability_context_type [not null, note: 'e.g. BRANCH_DAY']
  context_id uuid [not null, note: 'e.g. branch_day.id']
  valid_from timestamptz [not null, default: `now()`]
  valid_to timestamptz [note: 'NULL = permanent', check: `valid_to IS NULL OR valid_from <= valid_to`]
  source_type capability_source_type [not null, note: 'e.g. RELIEF_ACCESS']
  source_id uuid [not null, note: 'e.g. grant_relief_access.id']
  priority smallint [not null, default: 0, note: '''
    higher priority wins on conflict
    SYSTEM                   0
    RELIEF_ACCESS            10
    MEDICAL_MISSION_DELEGATE 20
    MANUAL_OVERRIDE          100
  ''']


  indexes {
    (user_id, capability_id, context_type, context_id) [unique]
    (user_id, valid_to) // time filtering
    (source_type, source_id) // source lookup
  }

  note: '''
    Stores granted capabilities scoped by context and time.
    Used for overrides such as relief access.

    polymorphic association:
    context_type (table name) + context_id (table.id)
    data integrity depends entirely on application logic. Acceptable, and intentional.

    allow overlaps:
    | Row | valid_from | valid_to |
    | --- | ---------- | -------- |
    | A   | 8:00       | 12:00    |
    | B   | 10:00      | 18:00    |

    sanity check:
    SELECT 1
    FROM user_capability
    WHERE user_id = ?
      AND capability_id = ?
      AND context_type = 'BRANCH_DAY'
      AND context_id = ?
      AND now() BETWEEN valid_from AND COALESCE(valid_to, 'infinity')
    ORDER BY priority DESC
    LIMIT 1
  '''
}

Table user_branch_assignment {
  id          uuid      [pk, default: `gen_random_uuid()`]
  user_id     uuid      [not null, ref: > app_user.id]
  branch_id   uuid      [not null, ref: > branch.id]
  slot        smallint  [not null, default: 0]
  assigned_by uuid      [not null, ref: >app_user.id]
  assigned_at timestamptz [not null, default: `now()`]
  ended_at    timestamptz [note: 'NULL means assignment is active']

  indexes {
    (user_id, branch_id) [unique, note: ''' Partial: WHERE ended_at IS NULL
      only one active assignment per user per branch; enforce partial index at db level WHERE ended_at IS NULL
    ''']
  }

  Note: '''
  SOURCE OF TRUTH FOR BRANCH MEMBERSHIP.

  Covers all roles — coordinators, practitioners, etc.
  A coordinator assigned here is the coordinator for that branch.

  ended_at IS NULL = currently active.
  ended_at IS NOT NULL = historical; user retains read-only access
  to records up to ended_at for that branch.

  Slot is cosmetic ordering only (senior = lower number).
  No slot history is tracked.
  '''
}

Enum branch_type {
  CLINIC
  PROVINCIAL_TOUR
  MEDICAL_MISSION
}

Table branch {
  id          uuid        [pk, default: `gen_random_uuid()`]
  branch_type branch_type [not null, default: 'CLINIC']
  name        text        [not null]

  indexes {
    (branch_type, name) [unique]
  }
}

Enum relief_status {
  PENDING
  GRANTED
  DENIED
}

// workflow table
Table grant_relief_access {
  id             uuid          [pk, default: `gen_random_uuid()`]
  branch_day_id  uuid          [not null, ref: > branch_day.id]
  requested_by   uuid          [not null, ref: > app_user.id]
  request_status relief_status [not null, default: 'PENDING']
  target_user    uuid          [not null, ref: > app_user.id]
  granted_by     uuid          [ref: > app_user.id]
  granted_at     timestamptz

  indexes {
    (branch_day_id, requested_by) [unique]
  }

  checks {`
    (request_status = 'GRANTED' AND granted_by IS NOT NULL AND granted_at IS NOT NULL)
    OR
    (request_status != 'GRANTED')
  `}

  Note: '''
  Scoped per branch_day. A relief user selects a currently
  checked-in user at the branch and requests edit access.
  Any checked-in user can grant — Coordinator presence not required.
  Access expires at end of calendar day.
  For multi-day relief, a new request is made each day.
  '''
}

// workflow table
Table medical_mission_delegate {
  id          uuid      [pk, default: `gen_random_uuid()`]
  target_user uuid      [not null, ref: > app_user.id]
  assigned_at timestamptz [not null, default: `now()`]
  assigned_by uuid      [not null, ref: > app_user.id]
  ended_at    timestamptz [note: 'NULL means currently active delegate']

  Note: '''
  Tracks which SPECIAL_COORDINATOR users are authorized to manage
  medical mission attendance and act as coordinator for medical missions.
  Multiple active delegates allowed.
  ended_at IS NULL = currently active.
  '''
}

// ============================================================
// ATTENDANCE & DAY STATE
// ============================================================

// actual presence
Table attendance {
  id            uuid    [pk, default: `gen_random_uuid()`]
  branch_day_id uuid    [not null, ref: > branch_day.id]
  user_id       uuid    [not null, ref: > app_user.id]
  marked_by     uuid    [not null, ref: > app_user.id]
  present       boolean [not null]

  indexes {
    (user_id, branch_day_id) [unique]
  }

  Note: 'Invariant: Actual presence. Must reference a valid user in branch_day_assignment for this branch_day.'
}

Table attendance_history {
  id            uuid    [pk, default: `gen_random_uuid()`]
  branch_day_id uuid    [not null, ref: > branch_day.id]
  user_id       uuid    [not null, ref: > app_user.id]
  marked_by     uuid    [not null, ref: > app_user.id]
  present       boolean [not null]

  note: 'snapshot at end-of-day'
}

Enum day_status {
  OPEN
  PAST
  REMITTED
}

Table branch_day {
  id        uuid       [pk, default: `gen_random_uuid()`]
  branch_id uuid       [not null, ref: > branch.id]
  date      date       [not null]
  status    day_status [not null, default: `OPEN`]

  indexes {
    (branch_id, date) [unique]
  }

   Note: '''
  POST-REMIT EDIT POLICY:

  Coordinators may edit records even after REMITTED status.

  ALL changes to financial and operational records MUST be logged
  in audit_log. Historical accuracy is maintained via audit trail,
  not immutability.

  OPEN  = current calendar day, all on-duty users can edit per access rules
  PAST  = previous day not yet remitted, Coordinator only, warning shown
  REMITTED = covered by a remittance, Coordinator only, stricter warning shown
  '''
}

// eligibility
Table branch_day_assignment {
  id            uuid    [pk, default: `gen_random_uuid()`]
  branch_day_id uuid    [not null, ref: > branch_day.id]
  user_id       uuid    [not null, ref: > app_user.id]
  is_relief     boolean [not null]

  indexes {
    (branch_day_id, user_id) [unique]
  }

  Note: 'Invariant: Defines eligibility. User must exist here before they can have an Attendance record.'
}

// ============================================================
// CLIENTS & SESSIONS
// ============================================================

Table client {
  id                 uuid        [pk, default: `gen_random_uuid()`]
  name               text        [not null]
  phone_number       varchar(20)
  address            text        [not null, default: 'N/A']
  gender             char        [not null, check: `gender in ('M', 'F')`]
  age                int         [not null, check: `age BETWEEN 0 AND 120`]
  systolic_bp        smallint    [check: `systolic_bp BETWEEN 40 AND 300`]
  diastolic_bp       smallint    [check: `diastolic_bp BETWEEN 20 AND 200`]
  medical_conditions text

  Note: '''
  Global record shared across all branches.
  BP fields must both be NULL or both be NOT NULL.

  session_number is a standard view
  '''

  checks {`
    (systolic_bp IS NULL AND diastolic_bp IS NULL)
    OR
    (systolic_bp IS NOT NULL AND diastolic_bp IS NOT NULL)
  `}
}

Enum session_type {
  REGULAR
  SECOND_SESSION
  SUBSEQUENT
  PROVINCIAL_FIRST
  MEDICAL_MISSION
}

Enum session_status {
  PENDING
  COMPLETED
  NO_SHOW
  CANCELLED
}

Table session {
  id                        uuid           [pk, default: `gen_random_uuid()`]
  client_id                 uuid           [not null, ref: > client.id]
  branch_day_id             uuid           [not null, ref: > branch_day.id, note: 'derive branch.id from branch_day_id']
  requested_practitioner_id uuid           [ref: > app_user.id]
  session_type              session_type   [not null]
  is_walk_in                boolean        [not null]
  session_status            session_status [not null, default: 'PENDING']
  base_price                numeric(10,2)  [not null, note: 'snapshot from session_base_rate.rate at time of session creation']
  final_price               numeric(10,2)  [not null]
  remarks                   text           [note: 'reason for discount or free session']
  other_concerns            text           [note: 'for concerns not in checkbox']
  booked_at                 timestamptz
  next_appointment_date     date           [check: `next_appointment_date >= booked_at::date`]
  created_at                timestamptz    [not null, default: `now()`]

  Checks {
    `NOT (is_walk_in = true AND session_status IN ('NO_SHOW', 'CANCELLED'))`
  }

  Note: '''
  session_type is auto-assigned:
    - MEDICAL_MISSION if branch.branch_type = MEDICAL_MISSION (always, regardless of history)
    - PROVINCIAL_FIRST if branch.branch_type = PROVINCIAL_TOUR AND client has no prior sessions
    - REGULAR if first session ever (non-medical-mission)
    - SECOND_SESSION if exactly one prior session
    - SUBSEQUENT if two or more prior sessions

  session_number (for display) is cached to client.session_number: COUNT of prior non-voided sessions for this client.

  Walk-in sessions cannot be marked NO_SHOW or CANCELLED.
  '''
}

Table session_void {
  id              uuid      [pk, default: `gen_random_uuid()`]
  session_id      uuid      [not null, ref: > session.id, unique]
  voided_at       timestamptz [not null, default: `now()`]
  voided_by       uuid      [not null, ref: > app_user.id]
  void_reason     text      [not null]
  unvoided_at     timestamptz
  unvoided_by     uuid      [ref: > app_user.id]
  unvoided_reason text

  Note: 'Only Coordinators can void and un-void.'

  checks {`
    (unvoided_at IS NULL AND unvoided_by IS NULL AND unvoided_reason IS NULL)
    OR
    (unvoided_at IS NOT NULL AND unvoided_by IS NOT NULL AND unvoided_reason IS NOT NULL)
  `}
}

Table session_base_rate {
  id             uuid          [pk, default: `gen_random_uuid()`]
  set_by         uuid          [not null, ref: > app_user.id, note: 'MUST be set from authenticated user context; never accept from client']
  branch_id      uuid          [not null, ref: > branch.id]
  session_type   session_type  [not null]
  rate           numeric(10,2) [not null]
  effective_from timestamptz     [not null]

  indexes {
    (branch_id, session_type, effective_from) [unique, note: 'effective_from allows rate history']
  }
}

Table session_practitioner {
  id              uuid [pk, default: `gen_random_uuid()`]
  session_id      uuid [not null, ref: > session.id]
  practitioner_id uuid [not null, ref: > app_user.id]
  remarks         text
  slot_at_time    smallint [not null]

  indexes {
    (session_id, practitioner_id) [unique]
  }

  Note: '''
    which practitioner was involved in this session?

    Display order within a session is by the practitioner slot number at their branch.
  '''
}

Table session_concern {
  session_id uuid [not null, ref: > session.id]
  concern_id uuid [not null, ref: > concern.id]

  indexes {
    (session_id, concern_id) [pk]
  }
}

Table concern {
  id    uuid [pk, default: `gen_random_uuid()`]
  label text [not null]

  Note: 'Waiver checkbox items. A free-text "other" field lives on the session itself if needed.'
}

// ============================================================
// PRODUCTS & INVENTORY
// ============================================================

Table branch_inventory {
  id            uuid [pk, default: `gen_random_uuid()`]
  branch_id     uuid [not null, ref: > branch.id]
  product_id    uuid [not null, ref: > product.id]
  current_stock int  [not null, check: `current_stock >= 0`, default: 0, note: '''
    use triggers to prevent drift
    lock with `forUpdate()` preventing race conditions
    ''']

  indexes {
    (branch_id, product_id) [unique]
  }

  Note: '''
  current_stock is a running total maintained via inventory_movement.
  Available = Stock − Sales − Tester − Sample − Missing (derived at query time).
  '''
}

Enum inventory_movement_reason {
  SESSION_SALE
  TESTER
  SAMPLE
  MISSING
  RESTOCK
  ADJUSTMENT
}

Table inventory_movement {
  id              uuid                      [pk, default: `gen_random_uuid()`]
  product_id      uuid                      [not null, ref: > product.id]
  session_id      uuid                      [ref: > session.id, note: 'set only for SESSION_SALE movements']
  branch_id       uuid                      [not null, ref: > branch.id]
  reason          inventory_movement_reason [not null]
  quantity_change int                       [not null, check: `quantity_change != 0`, note: 'negative for reductions, positive for additions']
  moved_by        uuid                      [not null, ref: > app_user.id]
  moved_at        timestamptz                 [not null, default: `now()`]

  indexes {
    (branch_id, product_id)
    (moved_at)
  }

  checks {`
    (reason = 'SESSION_SALE' AND session_id IS NOT NULL AND quantity_change < 0)
    OR
    (reason != 'SESSION_SALE' AND session_id IS NULL)
  `}

  Note: 'Append only. Compute branch_inventory.current_stock with inventory movement per transaction'
}

Table product {
  id                  uuid          [pk, default: `gen_random_uuid()`]
  name                text          [not null]
  product_category_id uuid          [not null, ref: > product_category.id]
  is_active           boolean       [not null, default: true]
  unit_price          numeric(10,2) [not null, check: `unit_price >= 0`]
  commission_amount   numeric(10,2) [not null, check: `commission_amount >= 0`]
}

Table product_category {
  id   uuid [pk, default: `gen_random_uuid()`]
  name text [not null, unique]

  Note: 'Customer pays unit_price + commission_amount. Commission is pooled daily and split among present staff.'
}

Table product_sale {
  id                        uuid          [pk, default: `gen_random_uuid()`]
  branch_day_id             uuid          [not null, ref: > branch_day.id]
  session_id                uuid          [ref: > session.id, note: 'NULL for walk-in sales']
  client_id                 uuid          [ref: > client.id, note: 'NULL if anonymous; required if session_id is NULL and client is known']
  is_walk_in                boolean       [not null, default: false]
  product_id                uuid          [not null, ref: > product.id]
  product_name              text          [not null, note: 'snapshot at time of sale']
  handled_by                uuid          [not null, ref: > app_user.id]
  quantity                  smallint      [not null, check: `quantity >= 1`]
  unit_price_at_time        numeric(10,2) [not null]
  total_amount_at_time      numeric(10,2) [not null, note: '''
    total_amount_at_time = unit_price_at_time * quantity, computed and stored at insert
    prevents accumulating rounding errors from unit_price_at_time * quantity
  ''']
  commission_amount_at_time numeric(10,2) [not null]

  Checks {`
    (
      (is_walk_in = false AND session_id IS NOT NULL)
      OR
      (is_walk_in = true AND session_id IS NULL)
    )
    AND
    (
      (session_id IS NOT NULL AND client_id IS NULL)
      OR
      (session_id IS NULL AND client_id IS NOT NULL)
    )
  `}
}

// ============================================================
// FINANCE
// ============================================================

Table compensation {
  id            uuid          [pk, default: `gen_random_uuid()`]
  branch_day_id uuid          [not null, ref: > branch_day.id]
  user_id       uuid          [not null, ref: > app_user.id]
  amount        numeric(10,2) [not null, check: `amount >= 0`]
  assigned_by   uuid          [not null, ref: > app_user.id]
  assigned_at   timestamptz     [not null, default: `now()`]
  note          text

  indexes {
    (user_id, branch_day_id) [unique]
  }

  // TODO: allow user to select home branch as compensation source if needed

  Note: '''
  Assigned per day per user by Admin or Coordinator.
  Compensation is always non-zero.
  For relief duty, compensation is assigned to the branch where duty was performed.
  '''
}

// TODO: handle total_amount later
Table commission_pool {
  id uuid [pk, default: `gen_random_uuid()`]
  branch_day_id uuid [not null, ref: > branch_day.id]
  total_amount numeric(10,2) [not null, default: 0, check: `total_amount >= 0`, note: '''
    enforce via trigger
    never allow manual writes

    optionally, remove total_amount, compute always
  ''']
}

Table commission_split {
  id uuid [pk, default: `gen_random_uuid()`]
  branch_day_id uuid [not null, ref: > branch_day.id]
  user_id uuid [not null, ref: > app_user.id]
  amount numeric(10,2) [not null, check: `amount >= 0`]

  indexes {
    (branch_day_id, user_id) [unique]
  }
}

Table allowance {
  id            uuid          [pk, default: `gen_random_uuid()`]
  branch_day_id uuid          [not null, ref: > branch_day.id]
  user_id       uuid          [not null, ref: > app_user.id]
  amount        numeric(10,2) [not null, check: `amount >= 0`]
  assigned_by   uuid          [not null, ref: > app_user.id]
  assigned_at   timestamptz     [not null, default: `now()`]

  Note: 'Used for medical mission transport allowances. Separate from compensation and not subject to remittance.'
}

Enum expense_category {
  PANTRY
  COMMUNICATION
  WATER
  TRANSPORTATION
  ELECTRICITY
  RENTAL
  OFFICE_SUPPLIES
  FURNITURE_FIXTURES
  MISCELLANEOUS
}

Table expense {
  id            uuid             [pk, default: `gen_random_uuid()`]
  branch_day_id uuid             [not null, ref: > branch_day.id]
  amount        numeric(10,2)    [not null, check: `amount > 0`]
  category      expense_category [not null]
  notes         text
  created_by    uuid             [not null, ref: > app_user.id]
  created_at    timestamptz      [not null, default: `now()`]
  deleted_by    uuid             [ref: > app_user.id]
  deleted_at    timestamptz

  checks {`
    (deleted_by IS NULL AND deleted_at IS NULL)
    OR
    (deleted_by IS NOT NULL AND deleted_at IS NOT NULL)
  `}
}

// ============================================================
// REMITTANCE
// ============================================================

Enum remittance_type {
  SESSION
  PRODUCT
}

Enum remittance_method {
  BANK_TRANSFER
  HANDED_TO_ACCOUNTANT
}

Table remittance {
  id               uuid              [pk, default: `gen_random_uuid()`]
  type             remittance_type   [not null]
  branch_id        uuid              [not null, ref: > branch.id]
  method           remittance_method [not null]
  remittance_date  date              [not null]
  date_range_start date              [not null]
  date_range_end   date              [not null]
  submitted_by     uuid              [not null, ref: > app_user.id]
  created_at       timestamptz         [not null, default: `now()`]

  indexes {
    (branch_id, type, remittance_date) [unique]
    (branch_id, type, date_range_start, date_range_end) [note: '''
      EXCLUDE USING gist
      (branch_id WITH =, type WITH =, daterange(date_range_start, date_range_end, "[]") WITH &&)
      ''']
  }

  Note: '''
  total_amount is derived from remittance_line

  Two independent flows per branch: SESSION and PRODUCT.
  Only assigned Coordinator(s) can submit — cannot be delegated.
  On insert, all covered branch_days transition to REMITTED status.

  SESSION remittance: covers net session income (gross − compensation − expenses).
  PRODUCT remittance: covers product sales revenue (unit_price × quantity only; commission excluded).

  CRITICAL: Must have an exclusion constraint to prevent overlapping remittances.
  Flow: SESSION and PRODUCT are independent.

  SQL implementation required:
  CREATE EXTENSION IF NOT EXISTS btree_gist;
  ALTER TABLE remittance ADD CONSTRAINT no_remittance_overlap
  EXCLUDE USING gist (
    branch_id WITH =,
    type WITH =,
    daterange(date_range_start, date_range_end, '[]') WITH &&
  );
  '''

  checks {`
    date_range_start <= date_range_end
  `}
}

Table remittance_day_breakdown {
  id            uuid          [pk, default: `gen_random_uuid()`]
  remittance_id uuid          [not null, ref: > remittance.id]
  branch_day_id uuid          [not null, ref: > branch_day.id]

  indexes {
    (remittance_id, branch_day_id) [unique]
  }

  note: '''
    remittance_day_breakdown.amount is derived from remittance_line
  '''
}

Enum remittance_line_type {
  SESSION
  PRODUCT_SALE
}

Table remittance_line {
  id              uuid                 [pk, default: `gen_random_uuid()`]
  remittance_id   uuid                 [not null, ref: > remittance.id]
  type            remittance_line_type [not null]
  session_id      uuid                 [ref: > session.id]
  product_sale_id uuid                 [ref: > product_sale.id]
  created_by      uuid                 [ref: > app_user.id]
  created_at      timestamptz          [not null, default: `now()`]
  deleted_at      timestamptz // TODO: inconsistent with other soft-delete strategies, maybe change?
  amount          numeric(10,2)        [not null, note: 'snapshot at time of inclusion']

  indexes {
    (session_id) [unique, note: 'Partial: WHERE deleted_at IS NULL']
    (product_sale_id) [unique, note: 'Partial: WHERE deleted_at IS NULL']
  }

  Checks {`
  (type = 'SESSION' AND session_id IS NOT NULL AND product_sale_id IS NULL)
  OR
  (type = 'PRODUCT_SALE' AND product_sale_id IS NOT NULL AND session_id IS NULL)
  `}

  Note: '''
  RULE:
  - If type = SESSION → session_id must be set, product_sale_id must be NULL
  - If type = PRODUCT_SALE → product_sale_id must be set, session_id must be NULL

  INCLUSION RULES (enforced at application layer):
  1. Must belong to the same branch as remittance.branch_id
  2. Must fall within remittance date range
  3. Must not be voided or cancelled // TODO: enforce at db level?
  4. Must not already be included in another active remittance

  prefer financial correctness (derived total_amount) over micro-optimization (cached total_amount)

  Query example:
  SELECT SUM(
    CASE
      WHEN rl.type = 'SESSION' THEN s.final_price
      WHEN rl.type = 'PRODUCT_SALE' THEN ps.unit_price_at_time * ps.quantity
    END
  )
  FROM remittance_line rl
  LEFT JOIN session s ON rl.session_id = s.id
  LEFT JOIN product_sale ps ON rl.product_sale_id = ps.id
  WHERE rl.remittance_id = ?
  AND rl.deleted_at IS NULL;
  '''
}

// ============================================================
// AUDIT LOG
// ============================================================

Enum audit_action {
  INSERT
  UPDATE
  DELETE
}

Table audit_log {
  id         uuid         [pk, default: `gen_random_uuid()`]
  table_name text         [not null]
  record_id  uuid         [not null]
  action     audit_action [not null]
  changed_by uuid         [not null, ref: > app_user.id]
  changed_at timestamptz    [not null, default: `now()`]
  old_value  jsonb        [note: 'NULL on INSERT']
  new_value  jsonb        [note: 'NULL on DELETE']

  Note: '''
  Visible to all roles.
  All changes to financial and operational records must be logged here via the service layer.
  The audit trail provides historical accuracy — not immutability. Records may be updated.
  '''
}

// ============================================================
// VIEWS (defined in Flyway migrations, not DBML syntax)
// ============================================================

// daily_sales_summary
//   Aggregates per branch_day:
//   - gross_income: SUM(session.final_price) for completed, non-voided sessions
//   - total_compensation: SUM(compensation.amount)
//   - total_expenses: SUM(expense.amount)
//   - net_income: gross - compensation - expenses
//   - total_product_sales: SUM(unit_price_at_time * quantity) from product_sale
//   - total_commission: SUM(commission_amount_at_time * quantity) from product_sale

// monthly_remittance_summary
//   Aggregates per remittance:
//   - per-day breakdown (from remittance_day_breakdown)
//   - total sessions included (from remittance_line where type = SESSION)
//   - total product sales included (from remittance_line where type = PRODUCT_SALE)
