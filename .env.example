APP_PORT=any_unique_port

POSTGRES_DB=name_of_db
POSTGRES_USER=db_username
POSTGRES_PASSWORD=db_password

TEST_DB_NAME=company_app_test

DB_HOST=localhost
DB_PORT=any_unique_port

JWT_SECRET=must_be_64_characters
JWT_ISSUER=jwt_issuer
JWT_AUDIENCE=jwt_audience

AUTH_DUMMY_PASSWORD=must_be_64_characters

# k6 load-test credentials (test users auto-seeded on startup when set):
# TEST_* = GLOBAL-capability owner; SCOPED_* = branch-scoped principal bound
# to the K6 Fixture Branch (#411); RELIEF_* = relief requester principal
# holding capability without an assignment (#413).
TEST_USERNAME=test_owner_username
TEST_PASSWORD=test_owner_password
SCOPED_USERNAME=test_scoped_username
SCOPED_PASSWORD=test_scoped_password
RELIEF_USERNAME=test_relief_username
RELIEF_PASSWORD=test_relief_password

# Password-reset email delivery (all five values are required for email sending).
# Without SMTP, delivery fails closed (#897): reset codes stay valid for retry but
# neither the code nor the account identifier is ever written to logs.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=mailer@example.com
# SMTP_PASSWORD=provider_password
# SMTP_FROM=CompanyApp <mailer@example.com>
# Dev-only reset-code log relay (local console aid): never enable where logs are shipped/retained.
# PASSWORD_RESET_DEV_RELAY=true

# Incident-report GitHub delivery (both values are required; otherwise packets use server-log relay,
# and the triage loop files needs-triage issues from the log with docs/incident-report-runbook.md)
# GITHUB_TOKEN=github_pat_or_classic_token_with_repo_scope
# GITHUB_REPOSITORY=owner/repo
